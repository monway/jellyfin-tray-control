        self.add(vbox)
        
        lbl_amituofo = Gtk.Label(label="Amituofo")
        lbl_amituofo.get_style_context().add_class("about-title")
        lbl_chinese = Gtk.Label(label="阿彌陀佛")
        lbl_chinese.get_style_context().add_class("about-subtitle")
        
        lbl_app = Gtk.Label(label=(
            "\nJellyfin Tray Control v1.0\n"
            "Crafted with intention by Jesse \"Dylan\" Mahoney (何孟維).\n\n"
            "Free and Open Source under GPLv3+.\n"
            "Integration and study are encouraged;\n"
            "attribution is requested."
        ))
        lbl_app.get_style_context().add_class("about-text")
        lbl_app.set_justify(Gtk.Justification.CENTER)
        
        btn_close = Gtk.Button(label="Close")
        btn_close.get_style_context().add_class("gold-button")
        
