import shutil
import subprocess
import webbrowser
import gi

gi.require_version('Gtk', '3.0')
try:
    gi.require_version('AyatanaAppIndicator3', '0.1')
    from gi.repository import AyatanaAppIndicator3 as AppIndicator
except (ValueError, ImportError):
    gi.require_version('AppIndicator3', '0.1')
    from gi.repository import AppIndicator3 as AppIndicator

from gi.repository import Gtk, Gdk, GLib, Gio

FLATPAK_ID = "org.jellyfin.JellyfinServer"
WEB_URL = "http://localhost:8096"
SYSTEMD_UNIT = "jellyfin.service"
SYSTEMD_ENCODED_PATH = "jellyfin_2eservice"

ABOUT_CSS = b"""
        window.buddha-card {
            background-color: #12131a;
            border: 1px solid rgba(246, 211, 45, 0.28);
            border-radius: 16px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
        }
        .lotus-badge {
            margin-bottom: 2px;
        }
        .gold-header {
            color: #e5a50a;
        }
        .gold-sub {
            color: #f6d32d;
        }
        .card-sep {
            background-color: rgba(246, 211, 45, 0.18);
            min-height: 1px;
            margin-top: 4px;
            margin-bottom: 4px;
        }
        .buddha-btn {
            background-image: linear-gradient(to bottom, #20222e, #181922);
            color: #e5a50a;
            font-weight: bold;
            border: 1px solid rgba(246, 211, 45, 0.35);
            border-radius: 8px;
            padding: 7px 32px;
        }
        .buddha-btn:hover {
            background-image: linear-gradient(to bottom, #2a2c3d, #20222e);
            color: #f6d32d;
            border-color: rgba(246, 211, 45, 0.65);
        }
"""

class JellyfinTray:
    def __init__(self):
        self._load_styles()
        self.backend = self._detect_backend()
        self.is_active = False
        self.bus = None

        self.indicator = AppIndicator.Indicator.new(
            "jellyfin-tray-control",
            "video-display-symbolic",
            AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)

        self.menu = Gtk.Menu()
        self.menu.connect("show", self._on_menu_show)

        self.status_item = Gtk.MenuItem(label="Status: Checking...")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.start_item = Gtk.MenuItem(label="Start Jellyfin Server")
        self.start_item.connect("activate", self._start_service)
        self.menu.append(self.start_item)

        self.stop_item = Gtk.MenuItem(label="Stop Jellyfin Server")
        self.stop_item.connect("activate", self._stop_service)
        self.menu.append(self.stop_item)

        self.web_item = Gtk.MenuItem(label="Open Web UI")
        self.web_item.connect("activate", lambda _: webbrowser.open(WEB_URL))
        self.menu.append(self.web_item)

        self.sep_item = Gtk.SeparatorMenuItem()
        self.menu.append(self.sep_item)

        self.about_item = Gtk.MenuItem(label="About")
        self.about_item.connect("activate", self._show_about)
        self.menu.append(self.about_item)

        self.quit_item = Gtk.MenuItem(label="Quit Tray")
        self.quit_item.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(self.quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        if self.backend == "systemd":
            self._setup_systemd_listener()
            self._check_systemd_status()
        elif self.backend == "flatpak":
            self._check_flatpak_status()
            GLib.timeout_add_seconds(10, self._check_flatpak_status)
        else:
            self._render_state(False, "NOT FOUND")

    def _load_styles(self):
        screen = Gdk.Screen.get_default()
        if screen:
            provider = Gtk.CssProvider()
            provider.load_from_data(ABOUT_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def _detect_backend(self):
        if shutil.which("systemctl"):
            res = subprocess.run(
                ["systemctl", "status", SYSTEMD_UNIT],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if res.returncode in (0, 3):
                return "systemd"

        if shutil.which("flatpak"):
            res = subprocess.run(
                ["flatpak", "info", FLATPAK_ID],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if res.returncode == 0:
                return "flatpak"

        return "none"

    def _setup_systemd_listener(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.bus.signal_subscribe(
                "org.freedesktop.systemd1",
                "org.freedesktop.DBus.Properties",
                "PropertiesChanged",
                None,
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_dbus_signal,
                None
            )
        except Exception:
            GLib.timeout_add_seconds(5, self._check_systemd_status)

    def _on_dbus_signal(self, conn, sender, path, interface, signal, params, user_data):
        if SYSTEMD_ENCODED_PATH in path:
            GLib.idle_add(self._check_systemd_status)

    def _on_menu_show(self, widget):
        if self.backend == "systemd":
            self._check_systemd_status()
        elif self.backend == "flatpak":
            self._check_flatpak_status()

    def _check_systemd_status(self):
        res = subprocess.run(
            ["systemctl", "is-active", "--quiet", "jellyfin"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        self.is_active = (res.returncode == 0)
        self._render_state(self.is_active, "Debian/Systemd")
        return True

    def _check_flatpak_status(self):
        res = subprocess.run(["flatpak", "ps"], capture_output=True, text=True)
        self.is_active = FLATPAK_ID in res.stdout
        self._render_state(self.is_active, "Flatpak")
        return True

    def _render_state(self, active, backend_label):
        if self.backend == "none":
            self.status_item.set_label("Status: BACKEND NOT FOUND")
            self.start_item.set_sensitive(False)
            self.stop_item.set_sensitive(False)
            self.indicator.set_icon_full("video-display-symbolic", "Jellyfin Missing")
            return

        if active:
            self.status_item.set_label(f"Status: RUNNING ({backend_label})")
            self.start_item.set_sensitive(False)
            self.stop_item.set_sensitive(True)
            self.indicator.set_icon_full("video-display", "Jellyfin Running")
        else:
            self.status_item.set_label(f"Status: STOPPED ({backend_label})")
            self.start_item.set_sensitive(True)
            self.stop_item.set_sensitive(False)
            self.indicator.set_icon_full("video-display-symbolic", "Jellyfin Stopped")

    def _call_systemd_manager(self, method):
        if not self.bus:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.bus.call(
            "org.freedesktop.systemd1",
            "/org/freedesktop/systemd1",
            "org.freedesktop.systemd1.Manager",
            method,
            GLib.Variant("(ss)", (SYSTEMD_UNIT, "replace")),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
            None
        )

    def _start_service(self, widget):
        if not self.is_active:
            if self.backend == "systemd":
                self._call_systemd_manager("StartUnit")
            elif self.backend == "flatpak":
                subprocess.Popen(["flatpak", "run", FLATPAK_ID])

    def _stop_service(self, widget):
        if self.backend == "systemd":
            self._call_systemd_manager("StopUnit")
        elif self.backend == "flatpak":
            subprocess.Popen(["flatpak", "kill", FLATPAK_ID])

    def _show_about(self, widget):
        if getattr(self, "_about_dialog", None) is not None:
            self._about_dialog.present()
            return

        window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        window.set_decorated(False)
        window.set_modal(True)
        window.set_resizable(False)
        window.set_position(Gtk.WindowPosition.CENTER)
        window.set_skip_taskbar_hint(True)
        window.set_skip_pager_hint(True)
        window.set_default_size(340, 310)
        window.get_style_context().add_class("buddha-card")

        self._about_dialog = window

        def _cleanup(*_):
            self._about_dialog = None
        window.connect("destroy", _cleanup)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(26)
        window.add(box)

        lotus = Gtk.Label()
        lotus.set_markup("<span font='40'>🪷</span>")
        lotus.get_style_context().add_class("lotus-badge")
        box.pack_start(lotus, False, False, 0)

        tribute = Gtk.Label()
        tribute.set_markup("<span weight='bold' size='large' letter_spacing='4500' foreground='#e5a50a'>AMITUOFO</span>")
        box.pack_start(tribute, False, False, 0)

        chars = Gtk.Label()
        chars.set_markup("<span size='small' alpha='85%' letter_spacing='3000' foreground='#f6d32d'>何 孟 維 佛</span>")
        box.pack_start(chars, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.get_style_context().add_class("card-sep")
        box.pack_start(sep, False, False, 6)

        title = Gtk.Label()
        title.set_markup("<span weight='bold' size='medium' foreground='#ffffff'>Jellyfin Tray Control</span>")
        box.pack_start(title, False, False, 0)

        author = Gtk.Label()
        author.set_markup("<span size='small' foreground='#c0bfbc'>Jesse Dylan Mahoney (何孟維)</span>")
        box.pack_start(author, False, False, 0)

        desc = Gtk.Label()
        desc.set_markup("<span size='x-small' alpha='65%' foreground='#a6adc8'>Lightweight Native Linux System Indicator</span>")
        box.pack_start(desc, False, False, 0)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btn_box.set_halign(Gtk.Align.CENTER)
        btn_close = Gtk.Button(label="Close")
        btn_close.get_style_context().add_class("buddha-btn")
        btn_close.connect("clicked", lambda w: window.destroy())
        btn_box.pack_start(btn_close, False, False, 0)
        box.pack_end(btn_box, False, False, 6)

        window.show_all()

def main():
    JellyfinTray()
    Gtk.main()

if __name__ == "__main__":
    main()
