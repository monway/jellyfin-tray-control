    def _update_progress(self, fraction, text):
        self.pbar.set_fraction(fraction)
        self.status_lbl.set_markup(f"<span size='x-small' foreground='#f5d77f'>{text}</span>")

    def _start_installation(self, widget):
        self.btn_install.set_sensitive(False)
        self.btn_cancel.set_sensitive(False)
        self.rb_native.set_sensitive(False)
        self.rb_flatpak.set_sensitive(False)
        self.chk_autostart.set_sensitive(False)

        target = "apt" if self.rb_native.get_active() else "flatpak"
        autostart = self.chk_autostart.get_active()
        threading.Thread(target=self._run_install_worker, args=(target, autostart), daemon=True).start()

    def _run_install_worker(self, target, autostart):
        if self.dry_run:
            steps = [
                (0.2, "Testing environment detection..."),
                (0.4, "Simulating repository setup..."),
                (0.7, "Simulating Jellyfin Server &amp; Player package fetch..."),
                (0.9, "Simulating Jellyfin Player configuration..."),
                (1.0, "Dry-run complete! Initializing tray controller...")
            ]
            for frac, msg in steps:
                import time
                time.sleep(1.0)
                GLib.idle_add(self._update_progress, frac, msg)
            import time
            time.sleep(0.5)
            GLib.idle_add(self._finish)
            return

        if target == "apt":
            cmds = [
                (0.2, "Importing official Jellyfin repository signing key...",
                 ["pkexec", "sh", "-c", "mkdir -p /etc/apt/keyrings && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key | gpg --dearmor -o /etc/apt/keyrings/jellyfin.gpg --yes"]),
                (0.4, "Configuring official repository sources...",
                 ["pkexec", "sh", "-c", ". /etc/os-release && echo \"Types: deb\\nURIs: https://repo.jellyfin.org/${ID}\\nSuites: ${VERSION_CODENAME}\\nComponents: main\\nArchitectures: $(dpkg --print-architecture)\\nSigned-By: /etc/apt/keyrings/jellyfin.gpg\" > /etc/apt/sources.list.d/jellyfin.sources"]),
                (0.6, "Updating APT indices...",
                 ["pkexec", "apt-get", "update"]),
                (0.8, "Installing Jellyfin Server &amp; Player...",
                 ["pkexec", "apt-get", "install", "-y", "jellyfin", "jellyfin-media-player"])
            ]
            if autostart:
                cmds.append((1.0, "Activating and starting Jellyfin systemd service...",
                             ["pkexec", "systemctl", "enable", "--now", SYSTEMD_UNIT]))
        else:
            cmds = [
                (0.3, "Enabling Flathub remote repository...",
                 ["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"]),
                (0.7, "Installing Jellyfin Server container...",
                 ["flatpak", "install", "-y", "flathub", FLATPAK_SERVER_ID]),
                (0.9, "Installing Jellyfin Player container...",
                 ["flatpak", "install", "-y", "flathub", FLATPAK_CLIENT_ID])
            ]
            if autostart:
                cmds.append((1.0, "Starting Jellyfin Server container...",
                             ["flatpak", "run", FLATPAK_SERVER_ID]))

        try:
            for frac, text, cmd in cmds:
                GLib.idle_add(self._update_progress, frac, text)
                res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                if res.returncode != 0:
                    GLib.idle_add(self._update_progress, frac, f"Error: Command failed ({res.returncode})")
                    GLib.idle_add(self.btn_cancel.set_sensitive, True)
                    return
            GLib.idle_add(self._finish)
        except Exception as e:
            GLib.idle_add(self._update_progress, 0.0, f"Failure: {str(e)}")
            GLib.idle_add(self.btn_cancel.set_sensitive, True)

    def _finish(self):
        self.destroy()
        self.on_complete_cb()


class JellyfinTray:
    def __init__(self):
        self._load_styles()
        self.backend = self._detect_backend()
        self.is_active = False
        self.bus = None

        self.indicator = AppIndicator.Indicator.new(
            "jellyfin-tray-control",
            "video-display-symbolic",
            AppIndicator.IndicatorCategory.APPLICATION_STATUS
        )
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)

        self.menu = Gtk.Menu()
        self.menu.connect("show", self._on_menu_show)

        self.status_item = Gtk.MenuItem(label="Status: Checking...")
        self.status_item.set_sensitive(False)
        self.menu.append(self.status_item)

        self.start_item = Gtk.MenuItem(label="Start Jellyfin Server")
        self.start_item.connect("activate", self._start_service)
        self.menu.append(self.start_item)

        self.stop_item = Gtk.MenuItem(label="Stop Jellyfin Server")
        self.stop_item.connect("activate", self._stop_service)
        self.menu.append(self.stop_item)

        self.restart_item = Gtk.MenuItem(label="Restart Jellyfin Server")
        self.restart_item.connect("activate", self._restart_service)
        self.menu.append(self.restart_item)

        self.client_item = Gtk.MenuItem(label="Launch Jellyfin Player")
        self.client_item.connect("activate", self._launch_client)
        self.menu.append(self.client_item)

        self.web_item = Gtk.MenuItem(label="Open Web UI")
        self.web_item.connect("activate", lambda _: webbrowser.open(WEB_URL))
        self.menu.append(self.web_item)

        self.sep_item = Gtk.SeparatorMenuItem()
        self.menu.append(self.sep_item)

        self.uninstall_item = Gtk.MenuItem(label="Complete Uninstall (Server, Player, Tray)")
        self.uninstall_item.connect("activate", self._confirm_uninstall)
        self.menu.append(self.uninstall_item)

        self.about_item = Gtk.MenuItem(label="About")
        self.about_item.connect("activate", self._show_about)
        self.menu.append(self.about_item)

        self.quit_item = Gtk.MenuItem(label="Quit Tray")
        self.quit_item.connect("activate", lambda _: Gtk.main_quit())
        self.menu.append(self.quit_item)

        self.menu.show_all()
        self.indicator.set_menu(self.menu)

        if self.backend == "systemd":
            self._setup_systemd_listener()
            self._check_systemd_status()
        elif self.backend == "flatpak":
            self._check_flatpak_status()
            GLib.timeout_add_seconds(10, self._check_flatpak_status)
        else:
            self._render_state(False, "NOT FOUND", "")

    def _load_styles(self):
        screen = Gdk.Screen.get_default()
        if screen:
            provider = Gtk.CssProvider()
            provider.load_from_data(APP_CSS)
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def _detect_backend(self):
        if shutil.which("systemctl"):
            res = subprocess.run(
                ["systemctl", "status", SYSTEMD_UNIT],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if res.returncode in (0, 3):
                return "systemd"

        if shutil.which("flatpak"):
            res = subprocess.run(
                ["flatpak", "info", FLATPAK_SERVER_ID],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if res.returncode == 0:
                return "flatpak"

        return "none"

    def _get_server_version(self):
        if self.backend == "systemd" and shutil.which("jellyfin"):
            try:
                res = subprocess.run(["jellyfin", "--version"], capture_output=True, text=True)
                lines = res.stdout.strip().splitlines()
                if lines:
                    return lines[0].split()[-1]
            except Exception:
                pass
        elif self.backend == "flatpak":
            try:
                res = subprocess.run(["flatpak", "info", FLATPAK_SERVER_ID], capture_output=True, text=True)
                for line in res.stdout.splitlines():
                    if "Version:" in line:
                        return line.split("Version:")[-1].strip()
            except Exception:
                pass
        return "10.9+"

    def _setup_systemd_listener(self):
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.bus.signal_subscribe(
                "org.freedesktop.systemd1",
                "org.freedesktop.DBus.Properties",
                "PropertiesChanged",
                None,
                None,
                Gio.DBusSignalFlags.NONE,
                self._on_dbus_signal,
                None
            )
        except Exception:
            GLib.timeout_add_seconds(5, self._check_systemd_status)

    def _on_dbus_signal(self, conn, sender, path, interface, signal, params, user_data):
        if SYSTEMD_ENCODED_PATH in path:
            GLib.idle_add(self._check_systemd_status)

    def _on_menu_show(self, widget):
        if self.backend == "systemd":
            self._check_systemd_status()
        elif self.backend == "flatpak":
            self._check_flatpak_status()

    def _check_systemd_status(self):
        res = subprocess.run(
            ["systemctl", "is-active", "--quiet", "jellyfin"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
        self.is_active = (res.returncode == 0)
        ver = self._get_server_version()
        self._render_state(self.is_active, "APT/Systemd", ver)
        return True

    def _check_flatpak_status(self):
        res = subprocess.run(["flatpak", "ps"], capture_output=True, text=True)
        self.is_active = FLATPAK_SERVER_ID in res.stdout
        ver = self._get_server_version()
        self._render_state(self.is_active, "Flatpak", ver)
        return True

    def _render_state(self, active, backend_label, version):
        if self.backend == "none":
            self.status_item.set_label("Status: BACKEND NOT FOUND")
            self.start_item.set_sensitive(False)
            self.stop_item.set_sensitive(False)
            self.restart_item.set_sensitive(False)
            self.indicator.set_icon_full("video-display-symbolic", "Jellyfin Missing")
            return

        ver_str = f" v{version}" if version else ""
        if active:
            self.status_item.set_label(f"Status: RUNNING ({backend_label}{ver_str})")
            self.start_item.set_sensitive(False)
            self.stop_item.set_sensitive(True)
            self.restart_item.set_sensitive(True)
            self.indicator.set_icon_full("video-display", "Jellyfin Running")
        else:
            self.status_item.set_label(f"Status: STOPPED ({backend_label}{ver_str})")
            self.start_item.set_sensitive(True)
            self.stop_item.set_sensitive(False)
            self.restart_item.set_sensitive(False)
            self.indicator.set_icon_full("video-display-symbolic", "Jellyfin Stopped")

    def _call_systemd_manager(self, method):
        if not self.bus:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.bus.call(
            "org.freedesktop.systemd1",
            "/org/freedesktop/systemd1",
            "org.freedesktop.systemd1.Manager",
            method,
            GLib.Variant("(ss)", (SYSTEMD_UNIT, "replace")),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
            None
        )

    def _start_service(self, widget):
        if not self.is_active:
            if self.backend == "systemd":
                self._call_systemd_manager("StartUnit")
            elif self.backend == "flatpak":
                subprocess.Popen(["flatpak", "run", FLATPAK_SERVER_ID])

    def _stop_service(self, widget):
        if self.backend == "systemd":
            self._call_systemd_manager("StopUnit")
        elif self.backend == "flatpak":
            subprocess.Popen(["flatpak", "kill", FLATPAK_SERVER_ID])

    def _restart_service(self, widget):
        if self.backend == "systemd":
            self._call_systemd_manager("RestartUnit")
        elif self.backend == "flatpak":
            subprocess.run(["flatpak", "kill", FLATPAK_SERVER_ID])
            subprocess.Popen(["flatpak", "run", FLATPAK_SERVER_ID])

    def _is_player_installed(self):
        if shutil.which("jellyfinmediaplayer") or shutil.which("jellyfin-media-player"):
            return "native"
        if shutil.which("flatpak"):
            check = subprocess.run(
                ["flatpak", "info", FLATPAK_CLIENT_ID],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            if check.returncode == 0:
                return "flatpak"
        return None

    def _execute_player(self, player_type):
        env = os.environ.copy()
        env["LC_ALL"] = "C.UTF-8"
        if player_type == "native":
            binary = "jellyfinmediaplayer" if shutil.which("jellyfinmediaplayer") else "jellyfin-media-player"
            subprocess.Popen([binary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        elif player_type == "flatpak":
            subprocess.Popen(["flatpak", "run", FLATPAK_CLIENT_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        else:
            webbrowser.open(WEB_URL)

    def _show_server_stopped_warning(self, player_type):
        dialog = Gtk.MessageDialog(
            transient_for=None,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text="Jellyfin Server is Stopped"
        )
        dialog.format_secondary_text(
            "The Jellyfin Server must be running before launching Jellyfin Player.\n\nWould you like to start the server now?"
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Start Server & Launch", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()

        if response == Gtk.ResponseType.OK:
            self._start_service(None)
            GLib.timeout_add_seconds(2, lambda: self._execute_player(player_type) or False)

    def _prompt_and_install_player(self):
        dialog = Gtk.MessageDialog(
            transient_for=None,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Jellyfin Player Not Found"
        )
        dialog.format_secondary_text(
            "Jellyfin Player is not installed on your system.\n\nWould you like to install Jellyfin Media Player now?"
        )
        response = dialog.run()
        dialog.destroy()

        if response == Gtk.ResponseType.YES:
            PlayerInstallerModal(self)

    def _launch_client(self, widget):
        player_type = self._is_player_installed()

        if not player_type:
            self._prompt_and_install_player()
            return

        if not self.is_active:
            self._show_server_stopped_warning(player_type)
            return

        self._execute_player(player_type)

    def _confirm_uninstall(self, widget):
        dialog = Gtk.MessageDialog(
            transient_for=None,
            flags=0,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Complete Jellyfin Suite Removal"
        )
        dialog.format_secondary_text(
            "This will purge the Jellyfin Server, Jellyfin Player, and Jellyfin Tray Control from your system.\n\nAre you sure you want to proceed?"
        )
        response = dialog.run()
        dialog.destroy()

        if response == Gtk.ResponseType.YES:
            cmd = ["pkexec", "sh", "-c", "systemctl stop jellyfin || true; apt-get purge -y jellyfin jellyfin-server jellyfin-web jellyfin-media-player jellyfin-tray-control || true; rm -f /etc/apt/sources.list.d/jellyfin.sources /etc/apt/keyrings/jellyfin.gpg; flatpak uninstall -y org.jellyfin.JellyfinServer com.github.iwalton3.jellyfin-media-player || true"]
            subprocess.Popen(cmd)
            Gtk.main_quit()

