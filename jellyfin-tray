def _is_backend_present():
    if shutil.which("systemctl"):
        res = subprocess.run(["systemctl", "status", SYSTEMD_UNIT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode in (0, 3):
            return True
    if shutil.which("flatpak"):
        res = subprocess.run(["flatpak", "info", FLATPAK_SERVER_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0:
            return True
    return False

def start_tray():
    JellyfinTray()

def main():
    dry_run = "--test-installer" in sys.argv

    screen = Gdk.Screen.get_default()
    if screen:
        provider = Gtk.CssProvider()
        provider.load_from_data(APP_CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    if dry_run or not _is_backend_present():
        InstallerDialog(on_complete_cb=start_tray, dry_run=dry_run)
    else:
        start_tray()

    Gtk.main()

if __name__ == "__main__":
    main()
