        self.status_lbl.set_line_wrap(True)
        self.status_lbl.set_justify(Gtk.Justification.CENTER)
        self.status_lbl.set_markup("<span size='small' foreground='#e4e4eb'>Preparing background package installation...</span>")
        inner.pack_start(self.status_lbl, False, False, 4)

        self.pbar = Gtk.ProgressBar()
        self.pbar.set_fraction(0.1)
        inner.pack_start(self.pbar, False, False, 6)

        self.action_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.action_box.set_halign(Gtk.Align.CENTER)
        inner.pack_end(self.action_box, False, False, 4)

        self.show_all()
        threading.Thread(target=self._run_install_worker, daemon=True).start()

    def _set_progress(self, frac, text):
        self.pbar.set_fraction(frac)
        self.status_lbl.set_markup(f"<span size='small' foreground='#f5d77f'>{text}</span>")

    def _run_install_worker(self):
        if self.tray.backend == "flatpak":
            GLib.idle_add(self._set_progress, 0.3, "Connecting to Flathub repository...")
            subprocess.run(["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            GLib.idle_add(self._set_progress, 0.6, "Downloading & installing Jellyfin Player container...")
            res = subprocess.run(["flatpak", "install", "-y", "flathub", FLATPAK_CLIENT_ID], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            player_type = "flatpak"
        else:
            GLib.idle_add(self._set_progress, 0.3, "Updating package cache in background...")
            subprocess.run(["pkexec", "apt-get", "update"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            GLib.idle_add(self._set_progress, 0.7, "Installing Jellyfin Player package...")
            res = subprocess.run(["pkexec", "apt-get", "install", "-y", "jellyfin-media-player"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            player_type = "native"

        if res.returncode == 0:
            GLib.idle_add(self._set_progress, 1.0, "Installation complete!")
            GLib.idle_add(self._on_finish, player_type)
        else:
            GLib.idle_add(self._set_progress, 1.0, "Installation failed. Please check network/sources.")
            GLib.idle_add(self._show_close_button)

    def _show_close_button(self):
        btn = Gtk.Button(label="Close")
        btn.get_style_context().add_class("buddha-btn-secondary")
        btn.connect("clicked", lambda _: self.destroy())
        self.action_box.pack_start(btn, False, False, 0)
        self.action_box.show_all()

    def _on_finish(self, player_type):
        if self.tray.backend == "systemd":
            self.tray._check_systemd_status()
        elif self.tray.backend == "flatpak":
            self.tray._check_flatpak_status()

        if self.tray.is_active:
            self.status_lbl.set_markup("<span size='small' foreground='#f5d77f'>Launching Jellyfin Player...</span>")
            GLib.timeout_add_seconds(1, lambda: (self.destroy(), self.tray._execute_player(player_type)))
        else:
            self.status_lbl.set_markup(
                "<span size='small' foreground='#e4e4eb'>Player installed successfully.\n"
                "Server is currently stopped. Start server now?</span>"
            )
            btn_close = Gtk.Button(label="Later")
            btn_close.get_style_context().add_class("buddha-btn-secondary")
            btn_close.connect("clicked", lambda _: self.destroy())
            self.action_box.pack_start(btn_close, False, False, 0)

            btn_start = Gtk.Button(label="Start Server & Launch")
            btn_start.get_style_context().add_class("buddha-btn")
            btn_start.connect("clicked", lambda _: self._start_and_launch(player_type))
            self.action_box.pack_start(btn_start, False, False, 0)
            self.action_box.show_all()

    def _start_and_launch(self, player_type):
        self.tray._start_service(None)
        self.status_lbl.set_markup("<span size='small' foreground='#f5d77f'>Starting server & launching player...</span>")
        GLib.timeout_add_seconds(2, lambda: (self.destroy(), self.tray._execute_player(player_type)))


