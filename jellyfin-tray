        inner.pack_start(title, False, False, 0)

        chars = Gtk.Label()
        chars.set_markup("<span size='small' alpha='85%' letter_spacing='3000' foreground='#d4af37'>播 放 器 安 裝</span>")
        inner.pack_start(chars, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.get_style_context().add_class("card-sep")
        inner.pack_start(sep, False, False, 4)

