# ==============================================================================
#  SYSTEMD D-BUS ENGINE: Zero-Latency Backend
# ==============================================================================
class SystemdBackend:
    def __init__(self, service_name="jellyfin.service"):
        self.service_name = service_name
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.DEST = "org.freedesktop.systemd1"
        self.PATH = "/org/freedesktop/systemd1"
        self.MANAGER_IFACE = "org.freedesktop.systemd1.Manager"
        self.UNIT_IFACE = "org.freedesktop.systemd1.Unit"

    def is_active(self):
        """O(1) memory lookup of the service state. Zero shell overhead."""
        try:
            response = self.bus.call_sync(
                self.DEST, self.PATH, self.MANAGER_IFACE, "GetUnit",
                GLib.Variant("(s)", (self.service_name,)),
                None, Gio.DBusCallFlags.NONE, -1, None
            )
            unit_path = response.unpack()[0]

            prop_response = self.bus.call_sync(
                self.DEST, unit_path, "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", (self.UNIT_IFACE, "ActiveState")),
                None, Gio.DBusCallFlags.NONE, -1, None
            )
            return prop_response.unpack()[0] == "active"
        except Exception:
            return False

    def start_service(self): self._dispatch_action("StartUnit")
    def stop_service(self): self._dispatch_action("StopUnit")
    def restart_service(self): self._dispatch_action("RestartUnit")

    def _dispatch_action(self, method_name):
        """Asynchronously commands systemd. Returns instantly."""
        self.bus.call(
            self.DEST, self.PATH, self.MANAGER_IFACE, method_name,
            GLib.Variant("(ss)", (self.service_name, "replace")),
            None, Gio.DBusCallFlags.NONE, -1, None,
            lambda b, r, d: b.call_finish(r), None
        )

# ==============================================================================
#  SECURITY GUARDRAILS: Execution Isolation
# ==============================================================================
class SecurityGuard:
    @staticmethod
    def run_bg(cmd_list):
        """Detached execution prevents GTK UI freezing."""
        threading.Thread(
            target=subprocess.run, args=(cmd_list,), 
            kwargs={"daemon": True, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        ).start()

    @staticmethod
    def secure_terminal_launch():
        """
        SECURITY: Anti-Injection & Environment Sanitization
        Strips user environment variables and enforces absolute paths 
        to prevent shell hijacking.
        """
        safe_env = {
            "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
            "DISPLAY": os.environ.get("DISPLAY", ":0"),
            "XAUTHORITY": os.environ.get("XAUTHORITY", ""),
            "WAYLAND_DISPLAY": os.environ.get("WAYLAND_DISPLAY", "")
        }
        secure_command = [
            "/usr/bin/x-terminal-emulator", "-e",
            "/usr/bin/journalctl -u jellyfin.service -n 50 -f"
        ]
        
        def task():
            try:
                subprocess.run(
                    secure_command, env=safe_env, shell=False, check=True,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
            except Exception:
                pass # Swallow error to prevent crashes if terminal missing

        threading.Thread(target=task, daemon=True).start()

